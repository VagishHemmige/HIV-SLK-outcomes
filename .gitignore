# R, RStudio and Positron
.Rproj.user/
.Rhistory
.RData
.Ruserdata
.httr-oauth
.DS_Store

# Quarto. docs/ is the local render; GitHub Actions renders the site and
# publishes it to the gh-pages branch (.github/workflows/publish.yml)
/docs/
/.quarto/
**/*.quarto_ipynb

# Credentials
.Renviron
.env
*.pem
*.key

# Data files. SRTR data live outside the repository; this is a safety net,
# not access control.
/data-raw/
/data-private/
*.csv
*.xlsx
*.xls
*.rds
*.rda
*.RData
*.sas7bdat
*.sas7bcat
*.xpt
*.dta
*.sav
*.parquet
*.feather
*.arrow
*.fst

# Outputs, ignored until cleared for public release under the SRTR DUA
# (AGENTS.md, "Restricted data"). Removing these lines does not track tables
# saved as .csv or .rds: the data-format patterns above still hide those, so
# cleared tables need their own exceptions.
/figures/
/tables/

# Approved public files: add narrow exceptions here, never a whole format.
# !tests/fixtures/synthetic.csv
